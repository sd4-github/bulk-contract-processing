# Copy to .env and adjust as needed. All values are optional.
DATABASE_URL=sqlite:///./data/contracts.db
STORAGE_DIR=./data/storage
MAX_DOCS_PER_ZIP=1000
MAX_DOC_SIZE_MB=15
MAX_ZIP_SIZE_MB=1024
WORKER_CONCURRENCY=4
MOCK_FAILURE_RATE=0.0
MOCK_EXTRACTION_DELAY=0.05
MAX_RETRIES=3
QUEUE_POLL_SECONDS=0.5
STUCK_THRESHOLD_SECONDS=3600